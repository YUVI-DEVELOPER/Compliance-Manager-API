DATABASE_URL=postgresql+asyncpg://user:root@localhost:5432/ValidateNow
APP_NAME=ValidateNow
APP_ENV=development
APP_DEBUG=true
API_HOST=127.0.0.1
API_PORT=8005
FRONTEND_PORT=5175
RUN_MIGRATIONS_ON_STARTUP=true
AUDIT_REVIEW_SCHEDULER_ENABLED=true
AUDIT_REVIEW_SCHEDULER_INTERVAL_SECONDS=60
AUDIT_REVIEW_SCHEDULER_INITIAL_DELAY_SECONDS=10
VEEVA_MCP_BASE_URL=http://127.0.0.1:8010
VEEVA_AUDIT_EXTRACTION_CHUNK_DAYS=14
VEEVA_AUDIT_LOOKBACK_DAYS=30

LLM_ENABLED=True
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

DOCUMENT_AI_AUTOFILL_ENABLED=true
DOCUMENT_AI_AUTOFILL_USE_OCR=true
DOCUMENT_AI_USE_EMBEDDINGS=false
DOCUMENT_AI_USE_LLM_FALLBACK=true
DOCUMENT_AI_CONFIDENCE_THRESHOLD=0.68
DOCUMENT_AI_CLASSIFIER_MODEL=BAAI/bge-base-en

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=System Admin
PASSWORD_HASH_SCHEME=bcrypt
